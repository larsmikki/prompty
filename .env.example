# Copy this file to .env and fill in values for local development.
# In Docker / production, set these as container environment variables instead.

# Port the server listens on. Defaults to 3061 in dev, 3060 in the Docker image.
PORT=3061

# Directory where the SQLite database and uploaded images are stored.
# Defaults to ../data relative to the server build output.
# In the Docker image this is /app/data, mounted as a volume.
DATA_DIR=./data

# Optional fallback OpenAI API key. The settings page also accepts a key and
# stores it in the database; the env var is only used if the DB has no key.
# Leave empty to require users to configure their own key via Settings.
OPENAI_API_KEY=
